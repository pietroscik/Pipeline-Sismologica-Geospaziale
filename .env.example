# =============================================================================
# Pipeline Sismologica Geospaziale - Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# -----------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDR=alerts@pipeline.com
SMTP_TO_ADDRS=recipient1@email.com,recipient2@email.com
EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/TOKEN
WEBHOOK_URL=https://your-webhook-url.com/api/endpoint
WEBHOOK_ENABLED=true

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (Twilio)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SMS_TO_NUMBERS=+391234567890,+390987654321
SMS_ENABLED=false

# -----------------------------------------------------------------------------
# ALERT THRESHOLDS
# -----------------------------------------------------------------------------
ALERT_THRESHOLD_LOW=0.5
ALERT_THRESHOLD_MEDIUM=0.7
ALERT_THRESHOLD_HIGH=0.9
ALERT_THRESHOLD_CRITICAL=0.95

# -----------------------------------------------------------------------------
# MOBILE ANALYSIS CONFIGURATION
# -----------------------------------------------------------------------------
MOBILE_MIN_STATIONS=18
MOBILE_ALERT_THRESHOLD=0.7
MOBILE_MODEL_TYPE=xgboost
MOBILE_GENERATE_ALERTS=true

# -----------------------------------------------------------------------------
# FILE PATHS
# -----------------------------------------------------------------------------
DEFAULT_INPUT_CSV=examples/mobile_devices/scoperte_automatiche.csv.gz
DEFAULT_STATIONS_CSV=examples/mobile_devices/stations.csv
DEFAULT_OUTPUT_DIR=runs/mobile_analysis
DEFAULT_CONFIG_YAML=mobile/config/alert_config.yaml

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
LOG_MAX_SIZE_MB=5
LOG_BACKUP_COUNT=3

# -----------------------------------------------------------------------------
# FDSN CONFIGURATION
# -----------------------------------------------------------------------------
FDSN_NETWORK=IV
FDSN_CLIENT=INGV
FDSN_START=2005-01-01T00:00:00
FDSN_LOCATION=*
FDSN_WORKERS=4
FDSN_BLOCK_DAYS=30

# Note: All paths are relative to the project root directory
# Use absolute paths if needed, but relative paths are recommended
# =============================================================================
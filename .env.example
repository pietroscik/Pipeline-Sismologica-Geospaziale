# =============================================================================
# Pipeline Sismologica Geospaziale - Configuration Template
# =============================================================================
# Copy this file to .env and fill values. Never commit .env.

# Environment: dev | prod | test
ENVIRONMENT=dev
TZ=Europe/Rome

# PostgreSQL/PostGIS (docker-compose.yml)
POSTGRES_USER=sismologia_admin
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=sismologia_db
POSTGRES_PORT=5432

# Alert system overrides (optional)
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
ALERT_SMS_ENABLED=false
ALERT_TELEGRAM_ENABLED=false
ALERT_WEBHOOK_URL=

# Optional encryption key for ENC: values
ENCRYPTION_KEY=

# Optional MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=seismic-risk-model

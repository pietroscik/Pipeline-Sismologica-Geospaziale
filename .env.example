# =============================================================================
# Pipeline Sismologica Geospaziale - Configuration Template
# =============================================================================
# Copy this file to .env and fill values. Never commit .env.

# Environment: dev | prod | test
ENVIRONMENT=dev
TZ=Europe/Rome

# PostgreSQL/PostGIS (docker-compose.yml)
POSTGRES_USER=sismologia_admin
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=sismologia_db
POSTGRES_PORT=5432
# Host usato dall'API; in Docker coincide con il nome del servizio.
POSTGRES_HOST=localhost

# Alert system configuration (using standard prefixes)
EMAIL_ENABLED=false
WEBHOOK_ENABLED=false
SMS_ENABLED=false
TELEGRAM_ENABLED=false
WEBHOOK_URL=

# Email configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=your_email@example.com
EMAIL_TO=user1@example.com,user2@example.com

# Optional encryption key for ENC: values
ENCRYPTION_KEY=

# Optional MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=seismic-risk-model
# =============================================================================
# Pipeline Sismologica Geospaziale - Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control!
# 
# For multi-environment support, you can also create:
#   .env.dev, .env.prod, .env.test
# And set ENVIRONMENT=dev|prod|test
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
# Set the environment (dev, prod, test)
# This determines which config file to load: alert_config.{ENVIRONMENT}.yaml
ENVIRONMENT=dev

# Optional encryption key for sensitive credentials
# If set, credentials prefixed with 'ENC:' will be decrypted at runtime
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=your_fernet_key_here

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# -----------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDR=alerts@pipeline.com
SMTP_TO_ADDRS=recipient1@email.com,recipient2@email.com
EMAIL_ENABLED=true

# ============================================
# NOTIFICHE TELEGRAM
# ============================================
TELEGRAM_BOT_TOKEN=8712527241:AAH5KlPdfdVrbusIXkj3H1FLRg3h8SU2ZBE
TELEGRAM_CHAT_ID=6142306617
TELEGRAM_ENABLED=true


# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
# Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
# Slack Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/TOKEN
# Generic Webhook URL (fallback)
WEBHOOK_URL=https://your-webhook-url.com/api/endpoint
WEBHOOK_ENABLED=true

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (Twilio)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SMS_TO_NUMBERS=+391234567890,+390987654321
SMS_ENABLED=false

# -----------------------------------------------------------------------------
# ALERT THRESHOLDS
# -----------------------------------------------------------------------------
ALERT_THRESHOLD_LOW=0.5
ALERT_THRESHOLD_MEDIUM=0.7
ALERT_THRESHOLD_HIGH=0.9
ALERT_THRESHOLD_CRITICAL=0.95

# -----------------------------------------------------------------------------
# CAMPI FLEGREI SPECIFIC CONFIGURATION
# -----------------------------------------------------------------------------
# Minimum number of stations to trigger an alert
MIN_STATIONS_ALERT=15
# Time window for coincidence detection (hours)
COINCIDENCE_WINDOW=5.0
# Geographic center for spatial filtering
CENTER_LAT=40.8062
CENTER_LON=14.1410
MAX_DISTANCE_KM=50.0